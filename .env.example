# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrosense
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD

# Base de datos de prueba separada (para npm test)
DB_NAME_TEST=agrosense_test

# Puertos de la Arquitectura de Microservicios
GATEWAY_PORT=8080
GESTION_PORT=3001
SENSOR_PORT=3002
MEDICION_PORT=3003
ALERTA_PORT=3004

# URLs internas para comunicación HTTP entre microservicios
GESTION_SERVICE_URL=http://localhost:3001
SENSOR_SERVICE_URL=http://localhost:3002
MEDICION_SERVICE_URL=http://localhost:3003
ALERTA_SERVICE_URL=http://localhost:3004
